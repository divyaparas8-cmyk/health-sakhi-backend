  status      String   @default("Published") @db.VarChar(20)
  mediaUrl    String?  @db.VarChar(512) @map("media_url")
  tab         String   @db.VarChar(50) // 'meditation', 'affirmations', 'grooming', 'spiritual'
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sakhi_content")
}

model YoutubeVideo {
