  @@map("blog_feedbacks")
}

model SakhiDiaryEntry {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  entryDate      DateTime  @map("entry_date") @db.Date // One entry per day per user

  // symptoms, doctorNotes, diagnosis
  symptoms       String?   @db.Text
  doctorNotes    String?   @db.Text @map("doctor_notes")
  diagnosis      String?   @db.Text

  // nutrition
  meals          String?   @db.Text
  waterIntake    Float?    @default(0) @map("water_intake")
  dietType       String?   @db.VarChar(100) @map("diet_type")

  // harmony
  mood           String?   @db.VarChar(50)
  harmonyNotes   String?   @db.Text @map("harmony_notes")
  gratitude      String?   @db.Text

  // personal notes
  personalNotes  String?   @db.Text @map("personal_notes")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicines      SakhiDiaryMedicine[]
  reports        SakhiDiaryReport[]

  @@unique([userId, entryDate])
  @@map("sakhi_diary_entries")
}

model SakhiDiaryMedicine {
