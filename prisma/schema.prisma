model AdvisorChatMessage {
  id          String            @id @default(uuid())
  senderId    String            @map("sender_id")
  receiverId  String            @map("receiver_id")
  text        String            @db.Text
  contentType String            @default("text") @map("content_type") @db.VarChar(20)
  fileUrl     String?           @map("file_url") @db.VarChar(512)
  isRead      Boolean           @default(false) @map("is_read")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([senderId, receiverId])
  @@map("advisor_chat_messages")
}

// 1. Community Circles (Groups)
model CommunityCircle {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(50)  // e.g. "Heart", "Users", "Shield", "Star"
  color       String?  @db.VarChar(20)  // e.g. "#ff69b4"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     CommunityCircleMember[]
  messages    CommunityCircleMessage[]

  @@map("community_circles")
}

// 2. Circle Memberships (Users joining circles)
model CommunityCircleMember {
  circleId  String   @map("circle_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")
  isBlocked Boolean  @default(false) @map("is_blocked")

  circle    CommunityCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([circleId, userId])
  @@map("community_circle_members")
}

// 3. Circle Group Chat Messages
model CommunityCircleMessage {
  id          String   @id @default(uuid())
  circleId    String   @map("circle_id")
  userId      String   @map("user_id")
  message     String   @db.Text
  isAnonymous Boolean  @default(true) @map("is_anonymous")
  createdAt   DateTime @default(now()) @map("created_at")

  circle      CommunityCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("community_circle_messages")
}

// 4. Forum Conversations / Posts (Trending Conversations)
model CommunityPost {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String   @db.VarChar(255)
  tag         String   @db.VarChar(50)  // e.g. "Health", "Food", "Goals"
  content     String   @db.Text
  isAnonymous Boolean  @default(true) @map("is_anonymous")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     CommunityPostReply[]

  @@map("community_posts")
}

// 5. Forum Post Replies
model CommunityPostReply {
  id          String   @id @default(uuid())
  postId      String   @map("post_id")
  userId      String   @map("user_id")
  content     String   @db.Text
  isAnonymous Boolean  @default(true) @map("is_anonymous")
  createdAt   DateTime @default(now()) @map("created_at")

  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("community_post_replies")
}

