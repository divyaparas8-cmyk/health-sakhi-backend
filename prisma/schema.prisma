  read      Boolean  @default(false)
  type      String   @default("inquiry") @db.VarChar(50)
  role      String?  @db.VarChar(100)
  rating    Int?     @default(5)
  status    String   @default("pending") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_messages")
}

model ContentAsset {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(255)
  type        String   @db.VarChar(50) // 'Video' | 'Book' | 'Interactive'
  category    String   @db.VarChar(100) // 'Women Health', 'Heart Care', 'Mental Healing', 'Relationships', 'Cravings'
  language    String   @default("English") @db.VarChar(50)
  languageCode String  @default("en") @db.VarChar(10) @map("language_code")
  groupKey    String?  @db.VarChar(100) @map("group_key")
  status      String   @db.VarChar(20) // 'Published', 'Draft', 'Archived'
  mediaUrl    String?  @db.VarChar(512) @map("media_url") // Video MP4 path or Book PDF path
  description String?  @db.Text
  showOnLanding Boolean  @default(false) @map("show_on_landing")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  progress    UserContentProgress[]
  bookFeedbacks BookFeedback[]

  @@map("content_assets")
}

// Tracks member reading/watching progress for resume functionality
model UserContentProgress {
  id          String   @id @default(uuid())
  userId      String   @db.VarChar(36)  @map("user_id")
  contentId   String   @db.VarChar(36)  @map("content_id")
  contentType String   @db.VarChar(20)  @map("content_type")  // 'Video' | 'Book'
  position    Float    @default(0) // seconds for Video, page number for Book
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt @map("updated_at")

  content     ContentAsset @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("user_content_progress")
}

model SakhiContent {
