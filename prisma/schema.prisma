}

model Campaign {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(150)
  targetRole  String    @map("target_role") @db.VarChar(50) // all, member, advisor, affiliate
  channel     String    @db.VarChar(20) // push, email
  subject     String?   @db.VarChar(200)
  content     String    @db.Text
  status      String    @default("draft") @db.VarChar(20) // draft, scheduled, sent, cancelled
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("campaigns")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  eventName String   @map("event_name") @db.VarChar(100)
  eventData Json?    @map("event_data")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName, createdAt])
  @@map("analytics_events")
}

// ==========================================
// NEW: AI ORCHESTRATION & MEMORY DOMAIN (MySQL)
