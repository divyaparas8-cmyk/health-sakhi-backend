  @@map("ai_cost_tracking")
}

// ==========================================
// PAYMENT & COUPON DOMAIN
// ==========================================

model Payment {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  subscriptionId String?       @map("subscription_id")
  invoiceId      String?       @map("invoice_id")
  razorpayOrderId   String     @unique @db.VarChar(100) @map("razorpay_order_id")
  razorpayPaymentId String?    @db.VarChar(100) @map("razorpay_payment_id")
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR") @db.VarChar(10)
  status         PaymentStatus @default(CREATED)
  planSlug       String?       @db.VarChar(50) @map("plan_slug")
  couponCode     String?       @db.VarChar(50) @map("coupon_code")
  discountAmount Decimal       @default(0.00) @db.Decimal(10, 2) @map("discount_amount")
  failureReason  String?       @db.Text @map("failure_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@map("payments")
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique @db.VarChar(50)
  discountType   DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue  Decimal      @db.Decimal(10, 2) @map("discount_value")
  maxUsageTotal  Int          @default(100) @map("max_usage_total")
  maxUsagePerUser Int         @default(1) @map("max_usage_per_user")
  usageCount     Int          @default(0) @map("usage_count")
  minOrderAmount Decimal      @default(0.00) @db.Decimal(10, 2) @map("min_order_amount")
  applicablePlan String?      @db.VarChar(50) @map("applicable_plan") // null = all plans
  expiresAt      DateTime?    @map("expires_at")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  usages CouponUsage[]

  @@index([code, isActive])
  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  usedAt    DateTime @default(now()) @map("used_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@map("coupon_usages")
}

model LandingPageSection {
