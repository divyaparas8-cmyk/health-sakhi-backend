  updatedAt      DateTime  @updatedAt @map("updated_at")

  diaryEntry     SakhiDiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)

  @@map("sakhi_diary_medicines")
}

model SakhiDiaryReport {
  id             String    @id @default(uuid())
  diaryEntryId   String    @map("diary_entry_id")
  fileUrl        String    @db.VarChar(512) @map("file_url")
  fileName       String?   @db.VarChar(255) @map("file_name")

  createdAt      DateTime  @default(now()) @map("created_at")

  diaryEntry     SakhiDiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)

  @@map("sakhi_diary_reports")
}

model TranslationCache {
  id             String   @id @default(uuid())
  sourceText     String   @db.Text @map("source_text")
  targetLang     String   @db.VarChar(10) @map("target_lang")
  translatedText String   @db.Text @map("translated_text")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([sourceText(length: 255), targetLang])
  @@map("translation_caches")
}

model ChatMemory {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  question       String   @db.Text
  detectedIntent String   @map("detected_intent") @db.VarChar(100)
  matchedSource  String   @map("matched_source") @db.VarChar(20) // "faq" | "book" | "ai"
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_memories")
}



