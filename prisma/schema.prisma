datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS DEFINITIONS
// ==========================================

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum PlanRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  PAID
  UNPAID
  VOID
  REFUNDED
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}


// ==========================================
// 1. AUTHENTICATION & USER DOMAIN
// ==========================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id          String    @id @default(uuid())
  email       String    @db.VarChar(255)
  passwordHash String?  @db.VarChar(255) @map("password_hash")
  phone       String?   @db.VarChar(20)
  roleId      String    @map("role_id")
  isApproved  Boolean   @default(false) @map("is_approved")
  isSuspended Boolean   @default(false) @map("is_suspended")
  password    String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  role          Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  profile       UserProfile?
  sessions      UserSession[]
  planRequests  MemberPlanRequest[]
  subscriptions MemberSubscription[]
  invoices      Invoice[]
  advisor       Advisor?
  auditLogs     AuditLog[]
  moodLogs      MoodLog[]
  todoTasks     TodoTask[]
  financeTransactions FinanceTransaction[]
  aiChatSessions AIChatSession[]
  aiUsageLimits  AIUsageLimit[]
  appointments   Appointment[]
  bookProgress   BookProgress[]
  videoProgress  VideoProgress[]
  affiliate        Affiliate?
  referredBy       ReferralTracking?    @relation("ReferredUserRelation")
  notifications    Notification[]
  analyticsEvents  AnalyticsEvent[]
  memories         AIMemory[]
  recommendations  AIRecommendation[]
  escalations      AIEscalation[]
  usageLogs        AIUsageLog[]
  payments         Payment[]
  couponUsages     CouponUsage[]
  languagePreference UserLanguagePreference?
  periodProfile    PeriodProfile?
  periodLogs       PeriodLog[]

  communityCircles  CommunityCircleMember[]
  circleMessages    CommunityCircleMessage[]
  communityPosts    CommunityPost[]
  postReplies       CommunityPostReply[]
  bookFeedbacks     BookFeedback[]
  certificates      Certificate[]
  diaryEntries      SakhiDiaryEntry[]
  chatMemories      ChatMemory[]


  @@unique([email, deletedAt])
  @@index([roleId])
  @@map("users")
}

model UserProfile {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  fullName       String    @db.VarChar(150) @map("full_name")
  bio            String?   @db.Text
  avatarUrl      String?   @db.VarChar(512) @map("avatar_url")
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  streakCount    Int       @default(0) @map("streak_count")
  lastActiveDate DateTime  @map("last_active_date") @db.Date
  wellnessScore  Int       @default(0) @map("wellness_score")
  booksCompleted Int       @default(0) @map("books_completed")
  loginDays      Int       @default(0) @map("login_days")
  referralCount  Int       @default(0) @map("referral_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Certificate {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  level         String   // "basic" | "advance" | "gold" | "platinum"
  title         String
  issuedAt      DateTime @default(now()) @map("issued_at")
  certificateId String   @unique @map("certificate_id")
  pdfUrl        String?  @map("pdf_url")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certificates")
}

model OTPVerification {
  id             String   @id @default(uuid())
  email          String   @db.VarChar(255)
  otpHash        String   @db.VarChar(255) @map("otp_hash")
  expiresAt      DateTime @map("expires_at")
  attempts       Int      @default(0)
  resendCooldown DateTime @map("resend_cooldown")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([email, expiresAt])
  @@map("otp_verifications")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(512)
  userAgent String?  @db.VarChar(255) @map("user_agent")
  ipAddress String?  @db.VarChar(45) @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("sessions")
}

// ==========================================
// 2. MEMBERSHIP & SUBSCRIPTION DOMAIN
// ==========================================

model Plan {
  id               String       @id @default(uuid())
  name             String       @db.VarChar(50)
  slug             String       @db.VarChar(50)
  price            Decimal      @db.Decimal(10, 2)
  originalPrice    Decimal?     @db.Decimal(10, 2) @map("original_price")
  interval         PlanInterval @default(MONTHLY)
  status           PlanStatus   @default(ACTIVE)
  maxAiChatsPerDay Int          @default(5) @map("max_ai_chats_per_day")
  advisorCredits   Int          @default(0) @map("advisor_credits")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  features      PlanFeature[]
  subscriptions MemberSubscription[]
  requests      MemberPlanRequest[]

  @@unique([slug, deletedAt])
  @@map("plans")
}

model PlanFeature {
  id           String   @id @default(uuid())
  planId       String   @map("plan_id")
  featureName  String   @db.VarChar(100) @map("feature_name")
  featureValue String   @db.VarChar(100) @map("feature_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_features")
}

model MemberSubscription {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  planId      String             @map("plan_id")
  status      SubscriptionStatus @default(ACTIVE)
  startsAt    DateTime           @map("starts_at")
  endsAt      DateTime           @map("ends_at")
  autoRenew   Boolean            @default(true) @map("auto_renew")
  stripeSubId String?            @db.VarChar(100) @map("stripe_sub_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  invoices Invoice[]

  @@index([userId, status])
  @@map("member_subscriptions")
}

model MemberPlanRequest {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  requestedPlanId String            @map("requested_plan_id")
  status          PlanRequestStatus @default(PENDING)
  notes           String?           @db.Text
  reviewedBy      String?           @db.VarChar(36) @map("reviewed_by")
  reviewedAt      DateTime?         @map("reviewed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [requestedPlanId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("member_plan_requests")
}

model Invoice {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  subscriptionId String?       @map("subscription_id")
  invoiceNumber  String        @unique @db.VarChar(50) @map("invoice_number")
  amount         Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(10, 2) @map("discount_amount")
  tax            Decimal       @default(0.00) @db.Decimal(10, 2)
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime      @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription MemberSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  receipt      Receipt?

  @@index([invoiceNumber])
  @@map("invoices")
}

model Receipt {
  id            String   @id @default(uuid())
  invoiceId     String   @unique @map("invoice_id")
  receiptNumber String   @unique @db.VarChar(100) @map("receipt_number")
  url           String   @db.VarChar(512)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model Advisor {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  bio           String?   @db.Text
  photoUrl      String?   @db.VarChar(512) @map("photo_url")
  qualification String    @db.VarChar(255)
  status        String    @default("pending") @db.VarChar(20) // pending, approved, suspended
  hourlyRate    Decimal   @db.Decimal(10, 2) @map("hourly_rate")
  rating        Decimal   @default(5.00) @db.Decimal(3, 2)
  totalReviews  Int       @default(0) @map("total_reviews")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations AdvisorSpecialization[]
  availability    Json?
  appointments    Appointment[]
  earnings        AdvisorEarnings[]
  escalations     AIEscalation[]

  @@index([status])
  @@map("advisors")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  action      String   @db.VarChar(100)
  targetTable String   @map("target_table") @db.VarChar(100)
  targetId    String?  @map("target_id") @db.VarChar(36)
  changes     Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, action, createdAt])
  @@map("audit_logs")
}

model MoodLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  moodType  String   @db.VarChar(50) @map("mood_type") // Happy, Tired, Stressed, Low Energy
  intensity Int
  notes     String?  @db.Text
  loggedAt  DateTime @default(now()) @map("logged_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("mood_logs")
}

model TodoTask {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  title       String    @db.VarChar(255)
  category    String    @db.VarChar(50) // Health, Personal, Work
  dueDate     DateTime  @map("due_date") @db.Date
  dueTime     String?   @db.VarChar(15) @map("due_time") // Store time as HH:MM or HH:MM:SS format
  isCompleted Boolean   @default(false) @map("is_completed")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate, isCompleted])
  @@map("todo_tasks")
}

model FinanceCategory {
  id           String               @id @default(uuid())
  name         String               @unique @db.VarChar(50)
  type         String               @db.VarChar(20) // income, expense
  transactions FinanceTransaction[]

  @@map("finance_categories")
}

model FinanceTransaction {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  categoryId      String          @map("category_id")
  type            String          @db.VarChar(20) // income, expense
  amount          Decimal         @db.Decimal(12, 2)
  description     String?         @db.Text
  transactionDate DateTime        @map("transaction_date") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, transactionDate])
  @@map("finance_transactions")
}

model Affirmation {
  id          String   @id @default(uuid())
  text        String   @db.Text
  category    String   @db.VarChar(50) // Self-Love, Health, Confidence
  moodTrigger String?  @db.VarChar(50) @map("mood_trigger") // Happy, Tired, Stressed, Low Energy
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("affirmations")
}

model AIChatSession {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  title     String?         @default("New Chat Session") @db.VarChar(255)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  deletedAt DateTime?       @map("deleted_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIChatMessage[]
  actions   AIAction[]

  @@map("ai_chat_sessions")
}

model AIChatMessage {
  id          String        @id @default(uuid())
  sessionId   String        @map("session_id")
  senderRole  String        @db.VarChar(20) @map("sender_role") // system, user, assistant
  messageText String        @db.Text @map("message_text")
  tokensUsed  Int           @default(0) @map("tokens_used")
  createdAt   DateTime      @default(now()) @map("created_at")

  session     AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("ai_chat_messages")
}

model AIUsageLimit {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  chatDate  DateTime @map("chat_date") @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatDate])
  @@index([userId, chatDate])
  @@map("ai_usage_limits")
}

model AdvisorSpecialization {
  id                 String   @id @default(uuid())
  advisorId          String   @map("advisor_id")
  specializationName String   @db.VarChar(100) @map("specialization_name")
  createdAt          DateTime @default(now()) @map("created_at")

  advisor            Advisor  @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("advisor_specializations")
}

model Appointment {
  id             String              @id @default(uuid())
  userId         String              @map("user_id")
  advisorId      String              @map("advisor_id")
  availabilityId String              @map("availability_id")
  date           DateTime            @db.Date
  startTime      String              @db.VarChar(15) @map("start_time")
  endTime        String              @db.VarChar(15) @map("end_time")
  status         String              @default("scheduled") @db.VarChar(20) // scheduled, completed, cancelled, missed
  meetingLink    String?             @db.VarChar(512) @map("meeting_link")
  amountPaid     Decimal             @db.Decimal(10, 2) @map("amount_paid")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  advisor      Advisor             @relation(fields: [advisorId], references: [id], onDelete: Restrict)
  notes        ConsultationNotes?
  earnings     AdvisorEarnings[]

  @@index([userId])
  @@index([advisorId, date])
  @@map("appointments")
}

model ConsultationNotes {
  id            String      @id @default(uuid())
  appointmentId String      @unique @map("appointment_id")
  symptoms      String?     @db.Text
  diagnosis     String?     @db.Text
  treatmentPlan String      @db.Text @map("treatment_plan")
  prescriptions String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("consultation_notes")
}

model AdvisorEarnings {
  id            String      @id @default(uuid())
  advisorId     String      @map("advisor_id")
  appointmentId String      @map("appointment_id")
  amount        Decimal     @db.Decimal(10, 2)
  commission    Decimal     @db.Decimal(10, 2)
  payoutStatus  String      @default("pending") @db.VarChar(20) @map("payout_status") // pending, paid, processing
  payoutDate    DateTime?   @map("payout_date")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  advisor       Advisor     @relation(fields: [advisorId], references: [id], onDelete: Restrict)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([advisorId, payoutStatus])
  @@map("advisor_earnings")
}

// ==========================================
// CONTENT DOMAIN
// ==========================================

model Book {
  id             String          @id @default(uuid())
  title          String          @db.VarChar(255)
  author         String?         @db.VarChar(150)
  coverUrl       String?         @db.VarChar(512) @map("cover_url")
  description    String?         @db.Text
  totalChapters  Int             @default(0) @map("total_chapters")
  status         String          @default("draft") @db.VarChar(20) // draft, published
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  chapters       BookChapter[]
  progress       BookProgress[]
  translations   BookTranslation[]

  @@map("books")
}

model BookChapter {
  id            String           @id @default(uuid())
  bookId        String           @map("book_id")
  chapterNumber Int              @map("chapter_number")
  title         String           @db.VarChar(255)
  contentUrl    String           @db.VarChar(512) @map("content_url")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  book          Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  progress      BookProgress[]
  translations  BookTranslation[]

  @@unique([bookId, chapterNumber])
  @@index([bookId, chapterNumber])
  @@map("book_chapters")
}

model BookProgress {
  id                   String      @id @default(uuid())
  userId               String      @map("user_id")
  bookId               String      @map("book_id")
  chapterId            String      @map("chapter_id")
  lastReadPage         Int         @default(1) @map("last_read_page")
  completionPercentage Decimal     @default(0.00) @db.Decimal(5, 2) @map("completion_percentage")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter BookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, bookId])
  @@map("book_progress")
}

model BookTranslation {
  id                   String      @id @default(uuid())
  bookId               String      @map("book_id")
  chapterId            String      @map("chapter_id")
  languageCode         String      @db.VarChar(10) @map("language_code") // hi, mr, gu, ta
  translatedTitle      String      @db.VarChar(255) @map("translated_title")
  translatedContentUrl String      @db.VarChar(512) @map("translated_content_url")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  book    Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter BookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, languageCode])
  @@index([chapterId, languageCode])
  @@map("book_translations")
}

model Video {
  id           String         @id @default(uuid())
  title        String         @db.VarChar(255)
  description  String?        @db.Text
  videoUrl     String         @db.VarChar(512) @map("video_url")
  duration     Int            // in seconds
  playlistName String?        @db.VarChar(100) @map("playlist_name")
  isPremium    Boolean        @default(false) @map("is_premium")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  progress     VideoProgress[]

  @@map("videos")
}

model VideoProgress {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  videoId              String   @map("video_id")
  lastWatchedTimestamp Int      @default(0) @map("last_watched_timestamp") // in seconds
  completed            Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, videoId])
  @@map("video_progress")
}

model MeditationSession {
  id        String    @id @default(uuid())
  title     String    @db.VarChar(255)
  category  String    @db.VarChar(50) // Sleep, Focus, Anxiety
  audioUrl  String    @db.VarChar(512) @map("audio_url")
  duration  Int       // in seconds
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("meditation_sessions")
}

model Affiliate {
  id             String             @id @default(uuid())
  userId         String             @unique @map("user_id")
  referralCode   String             @unique @map("referral_code")
  totalEarnings  Decimal            @default(0.00) @db.Decimal(10, 2) @map("total_earnings")
  createdAt      DateTime           @default(now()) @map("created_at")

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet         AffiliateWallet?
  referrals      ReferralTracking[]

  @@map("affiliates")
}

model ReferralTracking {
  id               String   @id @default(uuid())
  referralCode     String   @map("referral_code")
  referredUserId   String   @unique @map("referred_user_id")
  signupDate       DateTime @default(now()) @map("signup_date")
  conversionStatus String   @default("SIGNED_UP") @map("conversion_status") // SIGNED_UP / PAID

  affiliate        Affiliate @relation(fields: [referralCode], references: [referralCode], onDelete: Cascade)
  referredUser     User      @relation("ReferredUserRelation", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@map("referral_tracking")
}

model AffiliateWallet {
  id          String    @id @default(uuid())
  affiliateId String    @unique @map("affiliate_id")
  balance     Decimal   @default(0.00) @db.Decimal(10, 2)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("affiliate_wallet")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String    @db.VarChar(150)
  message   String    @db.Text
  type      String    @default("system") @db.VarChar(50) // system, appointment, billing, campaign
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

