model AIMemory {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  category   String   @default("PREFERENCE") @db.VarChar(50)
  key        String   @db.VarChar(100)
  value      Json
  confidence Float    @default(1.0)
  sourceMsg  String?  @db.Text @map("source_msg")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, category])
  @@map("ai_memories")
}

model AIAction {
  id          String    @id @default(uuid()) @db.VarChar(36)
  sessionId   String    @map("session_id") @db.VarChar(36)
  actionType  String    @map("action_type") @db.VarChar(50)
  payload     Json
  status      String    @default("pending") @db.VarChar(20)
  result      Json?
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  session AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("ai_actions")
}

model AIRecommendation {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String   @map("resource_id") @db.VarChar(36)
  context      String   @db.Text
  isClicked    Boolean  @default(false) @map("is_clicked")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_recommendations")
}

model AIWorkflow {
  id               String   @id @default(uuid()) @db.VarChar(36)
  name             String   @unique @db.VarChar(100)
  triggerCondition String   @map("trigger_condition") @db.VarChar(255)
  steps            Json
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("ai_workflows")
}

model AIEscalation {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userId     String    @map("user_id") @db.VarChar(36)
  advisorId  String?   @map("advisor_id") @db.VarChar(36)
  severity   String    @default("medium") @db.VarChar(20)
  reason     String    @db.Text
  status     String    @default("open") @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisor Advisor? @relation(fields: [advisorId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("ai_escalations")
}

model AIPromptTemplate {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String   @unique @db.VarChar(100)
  promptText String   @db.Text @map("prompt_text")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("ai_prompt_templates")
}

model AIUsageLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
